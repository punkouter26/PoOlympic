<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="MainMenu.uss" />
    <ui:VisualElement name="root" class="menu-root">
        <ui:VisualElement name="panel" class="menu-panel">
            <ui:Label text="POOLYMPICS" class="title" />
            <ui:Label text="Pick 8 athletes and an event" class="subtitle" />
            <ui:Label text="ATHLETES" class="section-title" />
            <ui:VisualElement name="slots" class="slots" />
            <ui:Label text="EVENT" class="section-title" />
            <ui:ScrollView name="eventList" class="event-list" />
            <ui:Label name="eventRules" class="event-rules" />
            <ui:Button name="playButton" text="PLAY" class="play-button" />
            <ui:Label name="status" class="status" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
