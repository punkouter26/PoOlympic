.menu-root {
    flex-grow: 1;
    align-items: center;
    background-color: rgb(12, 18, 32);
}

.menu-panel {
    flex-grow: 1;
    width: 100%;
    max-width: 760px;
    padding: 48px 36px 36px 36px;
}

.title {
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 72px;
    -unity-text-align: middle-center;
    color: rgb(255, 216, 74);
    letter-spacing: 4px;
}

.subtitle {
    font-size: 26px;
    -unity-text-align: middle-center;
    color: rgb(150, 162, 186);
    margin-bottom: 36px;
}

.section-title {
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 28px;
    color: rgb(150, 162, 186);
    letter-spacing: 3px;
    margin: 12px 0 12px 4px;
}

.section-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.section-hint {
    font-size: 20px;
    color: rgb(150, 162, 186);
    margin-right: 4px;
}

.roster-row {
    flex-direction: row;
    align-items: stretch;
}

.roster {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
}

.athlete-card {
    width: 230px;
    height: 120px;
    margin: 0 12px 0 0;
    padding: 10px 16px;
    align-items: flex-start;
    justify-content: center;
    background-color: rgb(28, 39, 63);
    border-width: 2px;
    border-color: rgb(255, 216, 74);
    border-radius: 14px;
    color: rgb(232, 236, 244);
    transition-duration: 0.12s;
}

.athlete-card:hover {
    background-color: rgb(38, 52, 82);
}

.athlete-name {
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 34px;
    color: rgb(255, 216, 74);
}

.athlete-stats {
    font-size: 19px;
    color: rgb(190, 199, 216);
}

.fill-button {
    width: 170px;
    font-size: 24px;
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(232, 236, 244);
    background-color: rgb(34, 45, 70);
    border-width: 0;
    border-radius: 14px;
}

.fill-button:hover {
    background-color: rgb(48, 62, 94);
}

.slots {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.slot {
    width: 49%;
    height: 84px;
    margin: 0 0 10px 0;
    padding: 0 18px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(20, 29, 48);
    border-width: 2px;
    border-color: rgb(20, 29, 48);
    border-radius: 12px;
    color: rgb(232, 236, 244);
    transition-duration: 0.12s;
}

.slot:hover {
    background-color: rgb(28, 39, 63);
}

.slot--selected {
    border-color: rgb(255, 216, 74);
}

.slot-lane {
    width: 110px;
    font-size: 24px;
    color: rgb(150, 162, 186);
}

.slot-athlete {
    flex-grow: 1;
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 30px;
}

.slot-athlete--empty {
    color: rgb(90, 102, 126);
}

.event-list {
    flex-grow: 1;
    background-color: rgb(20, 29, 48);
    border-radius: 16px;
    padding: 8px;
}

.event-button {
    flex-direction: row;
    align-items: center;
    height: 68px;
    margin: 4px;
    padding: 0 20px;
    background-color: rgb(28, 39, 63);
    border-width: 2px;
    border-color: rgb(28, 39, 63);
    border-radius: 12px;
    color: rgb(232, 236, 244);
    transition-duration: 0.12s;
}

.event-button:hover {
    background-color: rgb(38, 52, 82);
}

.event-button--selected {
    border-color: rgb(255, 216, 74);
    background-color: rgb(46, 52, 44);
}

.event-number {
    width: 70px;
    font-size: 30px;
    color: rgb(255, 216, 74);
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
}

.event-name {
    flex-grow: 1;
    font-size: 28px;
}

.event-brain {
    font-size: 20px;
    color: rgb(150, 162, 186);
}

.event-rules {
    font-size: 22px;
    color: rgb(190, 199, 216);
    white-space: normal;
    min-height: 96px;
    margin: 14px 4px;
}

.play-button {
    height: 110px;
    font-size: 44px;
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    color: rgb(12, 18, 32);
    background-color: rgb(255, 216, 74);
    border-width: 0;
    border-radius: 20px;
    transition-duration: 0.12s;
}

.play-button:hover {
    background-color: rgb(255, 228, 128);
}

.play-button:disabled {
    opacity: 0.4;
}

.status {
    font-size: 20px;
    color: rgb(150, 162, 186);
    -unity-text-align: middle-center;
    margin-top: 12px;
}

/* gauntlet builder + wallet (game layer) */
.gauntlet-toggle {
    height: 44px;
    padding: 0 20px;
    font-size: 22px;
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    letter-spacing: 2px;
    color: rgb(232, 236, 244);
    background-color: rgb(34, 45, 70);
    border-width: 0;
    border-radius: 10px;
}
.gauntlet-toggle--on {
    color: rgb(12, 18, 32);
    background-color: rgb(120, 220, 255);
}
.event-order {
    width: 44px;
    height: 44px;
    margin-left: 12px;
    font-size: 24px;
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    -unity-text-align: middle-center;
    color: rgb(12, 18, 32);
    background-color: rgb(120, 220, 255);
    border-radius: 22px;
}
.event-button--in-gauntlet {
    border-color: rgb(120, 220, 255);
}
.coins {
    font-size: 20px;
    color: rgb(120, 220, 255);
    -unity-text-align: middle-center;
    margin-top: 6px;
    white-space: normal;
}
