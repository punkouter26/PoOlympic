/* Main menu (MainMenu.uxml / MainMenuController.cs) — one viewport, nothing scrolls (UI consolidation 2026-09-29).
   The panel scales to 1920 units tall (PoOlympicPanelSettings: match height), so the column below always has the same
   height; the event grid takes what is left. Width is 690-1080 units depending on the phone.
   Sizes / colours: Tokens.uss (no text under 28, primary buttons 104). */
@import url("HudAnchors.uss");

.menu-root {
    flex-grow: 1;
    align-items: center;
    background-color: rgb(12, 18, 32);
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-Regular.ttf");
    color: var(--po-fg);
}
.menu-panel {
    flex-grow: 1;
    width: 100%;
    max-width: 1080px;
    padding: 12px 16px 8px 16px;
}
.menu-anchor { flex-shrink: 0; }
.menu-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
#anchorTop, .roster, .slots, .event-grid, .detail, .action-row { margin-bottom: var(--po-pad); }
.slots { margin-bottom: 4px; }

/* ---------- roster: tap a card = all 8 lanes ---------- */
.roster { flex-direction: row; flex-shrink: 0; }
.athlete-card {
    flex-grow: 1;
    flex-basis: 0;
    height: var(--po-btn);
    margin: 0;
    padding: 0 14px;
    flex-direction: row;
    align-items: center;
    background-color: var(--po-card);
    border-width: 2px;
    border-color: var(--po-gold);
    border-radius: 14px;
    color: var(--po-fg);
}
.athlete-card:hover { background-color: var(--po-card-hover); }
.athlete-card--gap { margin-right: var(--po-pad); }
.athlete-text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.athlete-name { -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); font-size: 34px; color: var(--po-gold); }
.athlete-stats { font-size: var(--po-text); color: var(--po-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.athlete-fill { font-size: var(--po-text); color: var(--po-cyan); -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }

/* body chips (same colours as the broadcast HUD) */
.menu-chip {
    width: 42px;
    height: 38px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: var(--po-text);
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    border-radius: 4px;
    background-color: rgb(52, 120, 220);
    color: rgb(255, 255, 255);
}
.menu-chip--zombie { background-color: rgb(92, 170, 70); color: rgb(12, 24, 8); }
.menu-chip--grandma { background-color: rgb(206, 96, 160); color: rgb(255, 255, 255); }

/* ---------- lanes: 4 × 2, tap = next athlete ---------- */
.slots { flex-direction: row; flex-wrap: wrap; justify-content: space-between; flex-shrink: 0; }
.slot {
    width: 24%;
    height: var(--po-btn);
    margin: 0;
    margin-bottom: var(--po-pad-s);
    padding: 0 10px;
    justify-content: center;
    align-items: flex-start;
    background-color: rgb(20, 29, 48);
    border-width: 2px;
    border-color: rgb(20, 29, 48);
    border-left-width: 8px;
    border-left-color: rgb(52, 120, 220);
    border-radius: 12px;
    color: var(--po-fg);
}
.slot:hover { background-color: var(--po-card); }
.slot--zombie { border-left-color: rgb(92, 170, 70); }
.slot--grandma { border-left-color: rgb(206, 96, 160); }
.slot--sub { opacity: 0.55; }
.slot--fixed { opacity: 0.7; }
.slot-lane { font-size: var(--po-text); color: var(--po-muted); }
.slot-athlete { -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); font-size: 30px; white-space: nowrap; }

/* ---------- events: fixed grid (rows grow to fill the viewport) ---------- */
.event-grid { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.event-row { flex-direction: row; flex-grow: 1; flex-basis: 0; min-height: 0; }
.event-row--gap { margin-bottom: var(--po-pad-s); }
.event-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
    padding: 10px 12px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    overflow: hidden;
    background-color: var(--po-card);
    border-width: 2px;
    border-color: var(--po-card);
    border-radius: 12px;
    color: var(--po-fg);
}
.event-button--gap { margin-right: var(--po-pad-s); }
.event-button:hover { background-color: var(--po-card-hover); }
.event-button--selected { border-color: var(--po-gold); background-color: rgb(46, 52, 44); }
.event-button--in-gauntlet { border-color: var(--po-cyan); }
.event-button--empty { visibility: hidden; }
.event-number { font-size: 34px; color: var(--po-gold); -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.event-name { font-size: var(--po-text); white-space: normal; }
.event-mark { font-size: var(--po-text); margin-top: 4px; color: var(--po-green); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.event-mark--none { color: var(--po-muted); }
.event-order {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 48px;
    height: 48px;
    font-size: var(--po-text);
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    -unity-text-align: middle-center;
    color: var(--po-ink);
    background-color: var(--po-cyan);
    border-radius: 24px;
}

/* ---------- selected event: rules + world record, or its all-time top 5 (★) ---------- */
.detail {
    height: 300px;
    flex-shrink: 0;
    overflow: hidden;
    padding: 10px 16px;
    background-color: rgb(20, 29, 48);
    border-radius: 14px;
}
.detail-head { flex-direction: row; align-items: center; height: 44px; }
.detail-title { flex-grow: 1; flex-shrink: 1; font-size: 32px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.detail-brain { font-size: var(--po-text); padding: 0 10px; border-radius: 4px; color: var(--po-soft); background-color: var(--po-card); }
.event-rules { font-size: var(--po-text); color: rgb(190, 199, 216); white-space: normal; flex-grow: 1; flex-shrink: 1; overflow: hidden; margin-top: 4px; }
.event-record { font-size: var(--po-text); color: var(--po-gold); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.record-top { flex-grow: 1; margin-top: 4px; display: none; }
.record-top-row { flex-direction: row; height: 44px; align-items: center; }
.record-top-rank { width: 44px; font-size: var(--po-text); color: var(--po-gold); -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.record-top-mark { flex-grow: 1; flex-shrink: 1; font-size: var(--po-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.record-top-who { flex-shrink: 1; margin-left: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: var(--po-text); color: rgb(200, 210, 228); }
.record-top-date { margin-left: 12px; white-space: nowrap; font-size: var(--po-text); color: var(--po-muted); }
.record-top-none { font-size: var(--po-text); color: var(--po-muted); }
.detail--records > .event-rules, .detail--records > .event-record { display: none; }
.detail--records > .record-top { display: flex; }

/* ---------- actions: ★ records · gauntlet · play ---------- */
.action-row { flex-direction: row; align-items: center; flex-shrink: 0; }
.chip-button {
    height: var(--po-btn);
    margin: 0;
    margin-right: var(--po-pad-s);
    padding: 0 22px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    font-size: var(--po-text);
    letter-spacing: 2px;
    color: var(--po-fg);
    background-color: var(--po-card);
    border-width: 0;
    border-radius: 14px;
}
.chip-button:hover { background-color: var(--po-card-hover); }
.records-button { width: var(--po-btn); padding: 0; font-size: 44px; letter-spacing: 0; color: var(--po-gold); }
.records-button--on { color: var(--po-ink); background-color: var(--po-gold); }
.gauntlet-toggle--on { color: var(--po-ink); background-color: var(--po-cyan); }
.play-button {
    flex-grow: 1;
    height: var(--po-btn);
    margin: 0;
    font-size: 44px;
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    color: var(--po-ink);
    background-color: var(--po-gold);
    border-width: 0;
    border-radius: 20px;
}
.play-button:hover { background-color: rgb(255, 228, 128); }
.play-button:disabled { opacity: 0.4; }

/* bottom bar centre: the last gauntlet result */
.menu-last { flex-grow: 1; flex-shrink: 1; font-size: var(--po-text); color: var(--po-cyan); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
