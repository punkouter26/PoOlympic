/* D3 broadcast HUD (BroadcastHud.cs) — authored at 1080 px wide, scaled onto the safe area.
   Consolidated portrait layout (2026-09-29): HudAnchors frame (TL title · TC FPS · TR clock + menu · BL debug ·
   BR version), standings with the result in place, a one-row story strip; nothing scrolls, no result card.
   Sizes / colours: Tokens.uss (no text under 28 px at 1080 wide ≈ 10 sp on a Pixel 9 Pro, buttons ≥ 104 px). */
@import url("HudAnchors.uss");

.bh-safe { position: absolute; background-color: var(--po-dock); }

.bh-frame {
    position: absolute;
    flex-direction: column;
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-Regular.ttf");
    color: var(--po-fg);
}

/* ---------- docks: the camera renders only into .bh-hole (BroadcastCamera.SetViewport) ---------- */
.bh-dock-top {
    flex-shrink: 0;
    padding: 12px 24px 10px 24px;
    background-color: var(--po-dock);
    border-bottom-width: 3px;
    border-bottom-color: var(--po-gold);
}
.bh-hole { flex-grow: 1; justify-content: center; }
.bh-dock-bottom {
    flex-shrink: 0;
    padding: 10px 24px 12px 24px;
    background-color: var(--po-dock);
    border-top-width: 3px;
    border-top-color: var(--po-cyan);
}

/* ---------- TR: clock beside the menu button ---------- */
.bh-clockbox {
    flex-shrink: 1;
    min-width: 0;
    margin-right: 14px;
    align-items: flex-end;
}
.bh-clock {
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 44px;
    color: var(--po-gold);
    white-space: nowrap;
}
.bh-info {
    font-size: var(--po-text);
    color: var(--po-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 330px;
}

/* ---------- standings (no header row: place · chip · lane · result speak for themselves) ---------- */
.bh-standings {
    margin-top: 8px;
    padding: 4px 8px;
    background-color: rgba(10, 16, 30, 0.72);
    border-radius: 8px;
}
.bh-row {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding: 0 6px;
    border-radius: 4px;
}
.bh-row > Label { font-size: 30px; }
.bh-c-place { width: 48px; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.bh-c-chip {
    width: 42px;
    height: 38px;
    margin-right: 12px;
    -unity-text-align: middle-center;
    font-size: var(--po-text);
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    border-radius: 4px;
}
.bh-chip-matt { background-color: rgb(52, 120, 220); color: rgb(255, 255, 255); }
.bh-chip-zombie { background-color: rgb(92, 170, 70); color: rgb(12, 24, 8); }
.bh-c-name { width: 92px; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.bh-c-result { flex-grow: 1; flex-shrink: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.bh-row > .bh-c-badge {
    font-size: var(--po-text);
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    padding: 0 10px;
    margin-left: 8px;
    border-radius: 4px;
    color: var(--po-ink);
    background-color: var(--po-cyan);
}
.bh-row > .bh-badge-wr { background-color: var(--po-green); }
.bh-c-odds { width: 110px; -unity-text-align: middle-right; color: var(--po-gold); }
.bh-row > .bh-expand { color: var(--po-cyan); font-size: var(--po-text); }
.bh-c-conf { width: 190px; flex-direction: row; align-items: center; }
.bh-spark { width: 96px; height: 28px; margin-right: 8px; }
.bh-conf-pct { width: 80px; font-size: var(--po-text); -unity-text-align: middle-right; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.bh-row-hot { border-width: 2px; border-color: var(--po-red); background-color: rgba(255, 90, 70, 0.16); }
.bh-row-first { background-color: rgba(255, 216, 74, 0.18); }
.bh-row-bad > Label { color: rgb(255, 120, 120); }
.bh-row-bet { border-width: 2px; border-color: var(--po-cyan); }
/* result: medals in place of the old podium card */
.bh-row-gold { border-left-width: 8px; border-left-color: rgb(255, 205, 60); background-color: rgba(255, 216, 74, 0.2); }
.bh-row-silver { border-left-width: 8px; border-left-color: rgb(200, 206, 216); background-color: rgba(200, 206, 216, 0.1); }
.bh-row-bronze { border-left-width: 8px; border-left-color: rgb(205, 127, 60); background-color: rgba(205, 127, 60, 0.12); }

/* ---------- result lines under the rows ---------- */
.bh-result {
    margin-top: 6px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.15);
}
.bh-wr { flex-direction: row; align-items: center; height: 46px; padding: 0 6px; }
.bh-wr-title {
    font-size: var(--po-text);
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    padding: 0 10px;
    margin-right: 12px;
    border-radius: 4px;
    color: var(--po-ink);
    background-color: var(--po-gold);
}
.bh-wr-mark { font-size: 30px; margin-right: 12px; white-space: nowrap; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.bh-wr-who { flex-grow: 1; flex-shrink: 1; font-size: var(--po-text); color: var(--po-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bh-wr-tag { font-size: 30px; color: var(--po-green); white-space: nowrap; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); transform-origin: right center; }
.bh-bests { flex-direction: row; flex-wrap: wrap; padding: 0 6px; }
.bh-best { flex-direction: row; align-items: center; height: 44px; margin-right: 18px; }
.bh-best-cap { font-size: var(--po-text); color: var(--po-muted); margin-right: 8px; letter-spacing: 1px; }
.bh-best-val { font-size: var(--po-text); white-space: nowrap; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.bh-card-line { font-size: var(--po-text); color: var(--po-soft); padding: 0 6px; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bh-card-good { font-size: 30px; color: var(--po-green); padding: 0 6px; margin-top: 4px; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }

/* ---------- banner (countdown / GO / the winner for a moment) ---------- */
.bh-banner {
    -unity-text-align: middle-center;
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 150px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

/* ---------- story strip: the athlete on camera (stats card + tiles merged into one row) ---------- */
.bh-story {
    flex-direction: row;
    align-items: center;
    height: 64px;
    margin-bottom: 8px;
    padding: 0 14px;
    background-color: var(--po-panel);
    border-left-width: 8px;
    border-left-color: var(--po-cyan);
    border-radius: var(--po-radius);
}
.bh-story > .bh-c-chip { margin-right: 10px; }
.bh-story-name { font-size: 32px; margin-right: 12px; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); white-space: nowrap; }
.bh-story-tag {
    font-size: var(--po-text);
    padding: 2px 10px;
    border-radius: 4px;
    white-space: nowrap;
    color: var(--po-ink);
    background-color: var(--po-cyan);
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
}
.bh-story-tag-hot { background-color: var(--po-red); }
.bh-story-gap { flex-grow: 1; }
.bh-story-val { font-size: 32px; margin-left: 22px; white-space: nowrap; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.bh-story-conf { flex-direction: row; align-items: center; }
.bh-story-spark { width: 90px; height: 28px; margin-left: 10px; }

/* ---------- bottom bar centre: ticker, or the primary action at the result ---------- */
.bh-ticker {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: var(--po-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--po-fg);
}
.bh-coins { font-size: var(--po-text); color: var(--po-cyan); margin-right: 14px; white-space: nowrap; }
.bh-btn-small, .bh-btn {
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    color: var(--po-ink);
    background-color: var(--po-gold);
    border-width: 0;
    border-radius: var(--po-radius);
    -unity-text-align: middle-center;
}
.bh-btn-small { font-size: var(--po-text-m); height: var(--po-btn); min-width: 250px; padding: 0 30px; margin: 0 0 0 14px; flex-shrink: 0; }
.bh-btn-primary { background-color: var(--po-green); border-width: 4px; border-color: rgb(255, 255, 255); }
.bh-btn { font-size: var(--po-text-m); height: 84px; padding: 0 34px; margin: 10px 14px 0 0; }
.bh-btn-small:hover, .bh-btn:hover { background-color: rgb(255, 230, 130); }
.bh-btn-primary:hover { background-color: rgb(160, 240, 170); }

/* ---------- overlay: betting slip (optional) ---------- */
.bh-overlay {
    position: absolute;
    left: 50px;
    right: 50px;
    top: 22%;
    padding: 30px 34px;
    background-color: rgba(10, 16, 30, 0.93);
    border-width: 3px;
    border-color: var(--po-gold);
    border-radius: 18px;
}
.bh-overlay-title {
    -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 56px;
    color: var(--po-gold);
    letter-spacing: 3px;
}
.bh-overlay-sub {
    font-size: var(--po-text);
    color: var(--po-soft);
    margin-bottom: 16px;
    white-space: normal;
}
.bh-slip-row {
    flex-direction: row;
    align-items: center;
    height: 70px;
    margin: 4px 0;
    padding: 0 16px;
    background-color: var(--po-card);
    border-width: 0;
    border-radius: var(--po-radius);
    color: var(--po-fg);
}
.bh-slip-row:hover { background-color: rgb(44, 60, 94); }
.bh-slip-name { width: 90px; font-size: 30px; -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.bh-slip-traits { flex-grow: 1; font-size: var(--po-text); color: var(--po-soft); }
.bh-slip-odds { width: 110px; font-size: 34px; -unity-text-align: middle-right; color: var(--po-gold); -unity-font: url("project://database/Assets/PoOlympic/UI/Fonts/Inter-SemiBold.ttf"); }
.bh-slip-bar { flex-direction: row; align-items: center; flex-wrap: wrap; margin-top: 10px; }
.bh-slip-timer { font-size: var(--po-text); color: var(--po-soft); margin-top: 10px; }
